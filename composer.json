{
    "name": "shoyim/latin-to-cyrillic",
    "description": "O'zbek tili uchun Lotin - Kirill - Yangi lotin transliteratsiya paketi (Laravel bilan integratsiya)",
    "keywords": ["uzbek", "ozbek", "lotin", "kirill", "cyrillic", "latin", "transliteration", "transliteratsiya", "laravel", "alifbo"],
    "homepage": "https://github.com/shoyim/latin-to-cyrillic",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shoyim Obloqulov",
            "email": "obloqulovshoyim1@gmail.com",
            "homepage": "https://github.com/shoyim"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shoyim\\LatinToCyrillic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shoyim\\LatinToCyrillic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shoyim\\LatinToCyrillic\\LatinCyrillicServiceProvider"
            ],
            "aliases": {
                "LatinCyrillic": "Shoyim\\LatinToCyrillic\\Facades\\LatinCyrillic"
            }
        }
    },
    "require": {
        "php": ">=7.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
